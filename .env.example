# ======================================================================
# Environment variables  (set these in Vercel -> Project -> Settings -> Environment Variables)
# Copy to backend/.env for local development. NEVER commit real values.
# ======================================================================

# ---- REQUIRED on Vercel ------------------------------------------------
# Hosted PostgreSQL connection string (Neon / Supabase / Vercel Postgres). SQLite does NOT persist on Vercel.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
# Long random string used to sign login tokens, e.g.  python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=

# ---- First administrator (created only when the users table is empty) ---
BOOTSTRAP_ADMIN_EMPLOYEE_ID=ADM001
BOOTSTRAP_ADMIN_NAME=System Administrator
BOOTSTRAP_ADMIN_PASSWORD=

# ---- Optional ------------------------------------------------------------
# development | production   (Vercel production deployments are detected automatically)
ENVIRONMENT=production
ACCESS_TOKEN_EXPIRE_MINUTES=720
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_SECONDS=300
# Only needed if the frontend is hosted on a DIFFERENT origin than the API (comma separated)
BACKEND_CORS_ORIGINS=
# Demo data (users OP101/OP102/QA201/SUP301/ADM001 + sample seatbelts). Leave false in production.
SEED_DEMO_DATA=false
DEMO_PASSWORD=
PLANT_LOCATION=Plant 02 - Singaperumalkovil Assembly Line
DEFAULT_COMPANY_NAME=AeroSafety Automotive Systems Ltd.

# ---- Frontend build-time variables (VITE_*) -----------------------------
# Leave empty to call the API on the same domain (/api/v1) - correct for a single Vercel project.
VITE_API_BASE_URL=
# Show the demo quick-scan shortcuts (only useful together with SEED_DEMO_DATA=true)
VITE_DEMO_MODE=false
VITE_STATION_NAME=Production Floor Station
