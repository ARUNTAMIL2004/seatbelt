{
  "name": "seatbelt-traceability",
  "private": true,
  "version": "1.1.0",
  "description": "Seatbelt production & traceability system (React/Vite frontend + FastAPI serverless API)",
  "engines": { "node": ">=22" },
  "scripts": {
    "install:frontend": "npm ci --prefix frontend",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:backend": "cd backend && python -m uvicorn app.main:app --reload --port 8000",
    "build": "npm run build --prefix frontend",
    "test:frontend": "npm run test --prefix frontend",
    "test:backend": "cd backend && python -m pytest tests -q",
    "lint": "npm run lint --prefix frontend"
  }
}
