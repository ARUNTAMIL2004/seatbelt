# Frontend build-time variables (optional). Copy to frontend/.env.local for local overrides.
# Empty => requests go to /api/v1 on the same origin (Vite dev proxy locally, same domain on Vercel).
VITE_API_BASE_URL=
VITE_DEMO_MODE=false
VITE_STATION_NAME=Production Floor Station
# Local dev proxy target for the FastAPI server
VITE_DEV_API_TARGET=http://127.0.0.1:8000
